# Registration lists that every feature branch adds one line to. Union merges keep both sides' lines instead of
# conflicting; `make guards` (scripts/check-lists.sh) then catches duplicates and broken one-entry-per-line format.
# A union merge cannot delete: when one branch removes an entry and another adds one beside it, the removed line
# comes back, so check the merged list by eye after landing a removal.
# scripts/e2e-not-ported.txt is left out on purpose: it mostly loses lines, so a union merge would bring them back.
App/UI/Window/WindowFeatures.swift merge=union
App/UI/App/AppFeatures.swift merge=union
E2E/Tests/E2EAreas.swift merge=union
App/Engine/Bow-Bridging-Header.h merge=union
App/UI/Sidebar/SidebarSectionList.swift merge=union
App/UI/Sidebar/SidebarMenuList.swift merge=union
App/UI/Sidebar/SidebarDropRuleList.swift merge=union
App/UI/Sidebar/SidebarAccessoryList.swift merge=union
